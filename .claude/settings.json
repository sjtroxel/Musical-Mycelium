      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git ls-files*)",
      "Bash(git show*)",
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform plan*)"
    ]
  }
